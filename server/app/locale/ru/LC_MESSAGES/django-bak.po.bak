#: main/notifications/compute_mail_content.py:61
msgid "Your reservation has been confirmed"
msgstr "Ваше бронирование подтверждено"

#: templates/admin/main/reservation/change_form.html:9
msgid "Confirm reservation"
msgstr "Подтвердить бронирование"

#: templates/emails/reservation_confirmed.html:5
msgid "Your reservation for {{site_name}} has been confirmed."
msgstr "Ваше бронирование в {{site_name}} подтверждено."

#: templates/emails/reservation_confirmed.html:10
#: templates/emails/reservation_confirmed.txt:5
#, python-format
msgid ""
"\n"
"        Hello, %(guest_name)s. Your reservation for %(site_name)s has been "
"confirmed! We will be waiting for you on %(check_in)s. If you need to "
"contact us please send a mail to %(manager_email)s.\n"
"      "
msgstr ""
"\n"
"        Здравствуйте, %(guest_name)s. Ваше бронирование в %(site_name)s "
"подтверждено! Мы ждем вас %(check_in)s. Если вам нужно связаться с нами, "
"пожалуйста, отправьте письмо на %(manager_email)s.\n"
"      "

#: templates/emails/reservation_confirmed.html:23
#: templates/emails/reservation_request.html:23
msgid "Check-in"
msgstr "Check-in"

#: templates/emails/reservation_confirmed.html:28
#: templates/emails/reservation_request.html:28
msgid "Check-out"
msgstr "Выезд"

#: templates/emails/reservation_confirmed.html:33
#: templates/emails/reservation_request.html:33
msgid "Guests"
msgstr "Гости"

