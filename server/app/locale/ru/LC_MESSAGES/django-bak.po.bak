msgid "%(adults)s adult"
msgid_plural "%(adults)s adults"
msgstr[0] "%(adults)s взрослый"
msgstr[1] "%(adults)s взрослых"
msgstr[2] "%(adults)s взрослых"

#. Translators: {{count}} adults and {{count}} children
#: templates/emails/reservation_confirmed.html:44
#: templates/emails/reservation_request.html:44
#, python-format
msgid "and %(children)s child"
msgid_plural "and %(children)s children"
msgstr[0] "и %(children)s ребенок"
msgstr[1] "и %(children)s детей"
msgstr[2] "и %(children)s детей"

#: templates/emails/reservation_confirmed.html:52
#: templates/emails/reservation_request.html:52
msgid "nights"
msgstr "ночей"

#: templates/emails/reservation_confirmed.html:66
#: templates/emails/reservation_request.html:66
msgid "Message"
msgstr "Сообщение"

#: templates/emails/reservation_request.html:4
msgid "A new reservation is requested"
msgstr "Получен новый запрос на бронирование"

#: templates/emails/reservation_request.html:9
msgid ""
" \n"
"    A reservation has been requested. Please check the reservation\n"
"    parameters and confirm or decline the reservation by following the link "
"to the\n"
"    administrator site. \n"
"  "
msgstr ""
" \n"
"    Поступил новый запрос на бронирование. Пожалуйста, проверьте параметры\n"
"    бронирования и подтвердите либо отклоните его, перейдя по ссылке в\n"
"    панель администратора. \n"
"  "

#: templates/emails/reservation_request.html:86
msgid "View reservation"
msgstr "Посмотреть бронирование"

#: templates/two_factor/_base.html:13
msgid "Guest-house administrator site"
msgstr "Панель администратора гостевого дома"

#: templates/two_factor/_wizard_actions.html:5
msgid "Cancel"
msgstr "Отмена"

#: templates/two_factor/_wizard_actions.html:10
#: templates/two_factor/_wizard_actions.html:12
msgid "Back"
msgstr "Назад"

#: templates/two_factor/_wizard_actions.html:14
msgid "Next"
msgstr "Далее"

#: templates/two_factor/core/login.html:10
msgid "Login"
msgstr "Войти"

#: templates/two_factor/core/login.html:13
msgid "Enter your credentials."
msgstr "Введите ваши учетные данные."

#: templates/two_factor/core/login.html:17
msgid ""
"Use this form for entering backup tokens for logging in. These tokens have "
"been generated for you to print and keep safe. Please enter one of these "
"backup tokens to login to your account."
msgstr ""
"Используйте эту форму для ввода резервных токенов доступа. Эти токены были "
"сгенерированы для того, чтобы вы могли их распечатать и хранить в надежном "
"месте. Пожалуйста, введите один из этих токенов для входа в свой аккаунт."

#: templates/two_factor/core/login.html:31
msgid "Or, alternatively, use one of your other authentication methods:"
msgstr "Или воспользуйтесь альтернативным методом аутентификации:"

#: templates/two_factor/core/login.html:51
msgid "As a last resort, you can use a backup token:"
msgstr "В крайнем случае вы можете использовать резервный токен:"

#: templates/two_factor/core/login.html:54
msgid "Use Backup Token"
msgstr "Использовать резервный токен"

#: templates/two_factor/core/otp_required.html:5
msgid "Permission Denied"
msgstr "Доступ запрещен"

#: templates/two_factor/core/otp_required.html:7
msgid ""
"The page you requested, enforces users to verify using two-factor "
"authentication for security reasons. You need to enable these security "
"features in order to access this page."
msgstr ""

#: templates/two_factor/core/otp_required.html:11
msgid ""
"Two-factor authentication is not enabled for your account. Enable two-factor "
"authentication for enhanced account security."
msgstr ""
"Запрашиваемая страница требует от пользователей прохождения двухфакторной "
"аутентификации из соображений безопасности. Чтобы получить доступ к этой "
"странице, вам необходимо включить данные функции безопасности."

#: templates/two_factor/core/otp_required.html:16
msgid "Go back"
msgstr "Вернуться"

#: templates/two_factor/core/otp_required.html:18
msgid "Enable Two-Factor Authentication"
msgstr "Включить двухфакторную аутентификацию"

